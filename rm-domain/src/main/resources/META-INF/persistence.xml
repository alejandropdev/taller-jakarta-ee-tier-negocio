<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <!-- El descriptor acompaña al mapeo de la entidad. Va en lib/ del EAR para que la unidad
         tenga alcance de toda la aplicación; el tier de negocio nunca la referencia. -->
    <persistence-unit name="resourceRequestPU" transaction-type="JTA">
        <jta-data-source>java:jboss/datasources/ResourceManagementDS</jta-data-source>
        <class>co.edu.javeriana.rm.domain.model.ResourceRequest</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <!-- H2 en memoria: el esquema se crea en cada arranque del contenedor -->
            <property name="hibernate.hbm2ddl.auto" value="create"/>
            <property name="hibernate.show_sql" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
